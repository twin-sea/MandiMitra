// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Used only by the Prisma CLI (migrate commands), never by the running
  // app. DATABASE_URL goes through Supabase's transaction-mode pooler,
  // which doesn't reliably support the database lock migrations take out
  // (that's why migrate commands were hanging intermittently) - directUrl
  // points migrations at the session pooler instead, which does.
  directUrl = env("DIRECT_URL")
}

model Farmer {
  id                Int      @id @default(autoincrement())
  name              String
  phone             String   @unique
  passwordHash      String
  state             String
  district          String
  preferredLanguage String   @default("hi")
  createdAt         DateTime @default(now())
}

model Crop {
  id            Int       @id @default(autoincrement())
  nameEn        String
  nameHi        String
  slug          String    @unique
  mspPerQuintal Float?
  createdAt     DateTime  @default(now())
  bookingCrops  BookingCrop[]
}

model Mandi {
  id        Int       @id @default(autoincrement())
  nameEn    String
  nameHi    String
  slug      String    @unique
  district  String
  state     String
   latitude  Float?
  longitude Float?
  // Real, per-mandi cap on how many farmers can be booked into the same
  // time slot on the same day, so slots stop filling before mandi staff
  // are overwhelmed. Configurable per mandi (a small local mandi and a
  // large central one don't have the same real throughput); starts at a
  // sensible default of 20 that whoever manages the mandi can adjust.
  slotCapacity Int     @default(20)
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

// One Booking is one real trip to the mandi: one time slot, one spot in the
// real queue - regardless of how many different crops the farmer is
// bringing that trip. Each crop+quantity the farmer is selling in that same
// trip is its own BookingCrop row below, so a farmer with wheat AND mustard
// to sell books ONE slot for both instead of needing two separate bookings
// (which used to cost them two queue spots and two trips through the form
// for what is really a single real visit to the mandi).
model Booking {
  id              Int      @id @default(autoincrement())
  tokenNumber     String   @unique
  farmerName      String
  farmerPhone     String
  mandiId         Int
  mandi           Mandi    @relation(fields: [mandiId], references: [id])
  slotDate        DateTime
  // A real 2-hour arrival window on slotDate, e.g. "06:00-08:00" (see
  // TIME_SLOTS in server.js). Nullable because bookings made before this
  // field existed genuinely have no time slot on record - we don't invent
  // one for them, the app just treats them as date-only, same as before.
  timeSlot        String?
  status          String   @default("CONFIRMED")
  createdAt       DateTime @default(now())
  crops           BookingCrop[]
  grievances      Grievance[]
}

// One crop+quantity line within a real booking. A booking with one crop has
// exactly one of these (that's still the common case); a booking with
// several crops has one row per crop.
model BookingCrop {
  id              Int      @id @default(autoincrement())
  bookingId       Int
  booking         Booking  @relation(fields: [bookingId], references: [id])
  cropId          Int
  crop            Crop     @relation(fields: [cropId], references: [id])
  quantityQuintal Float
}
model Grievance {
  id           Int      @id @default(autoincrement())
  ticketNumber String   @unique
  farmerName   String
  farmerPhone  String
  subject      String
  description  String
  status       String   @default("OPEN")
  bookingId    Int?
  booking      Booking? @relation(fields: [bookingId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
